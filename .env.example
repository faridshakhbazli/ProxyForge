# Copy this file to .env (untracked). Set your own random secrets.
# ADMIN_TOKEN must be at least 32 characters. Empty = use generated volume token.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_TOKEN=
# Agent runs on a separate host; set a DIFFERENT 32+ character token there.
AGENT_TOKEN=

# Development only: permit private-IP HTTP agents.
ALLOW_HTTP_AGENTS=false
